{
  "manifest_version": 2,
  "name": "old-tube",
  "version": "1.0.0",
  "description": "Filter YouTube search results and sidebar feeds to only show videos from specific years.",
  "permissions": [
    "*://*.youtube.com/*",
    "storage",
    "tabs"
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "old-tube"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
